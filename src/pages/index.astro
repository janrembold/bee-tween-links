---
import { songs } from '../data/songs';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Bee Tween</title>
    <style>
      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        background: #0c0a09;
        color: #f8f3ed;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, Helvetica, Arial, sans-serif;
      }

      body {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 28px 18px;
      }

      .container {
        width: min(100%, 430px);
        text-align: center;
      }

      h1 {
        font-size: 2rem;
        margin: 0 0 32px 0;
        letter-spacing: -0.025em;
        font-weight: 720;
      }

      .songs-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
      }

      .song-link {
        display: block;
        padding: 16px;
        background: rgba(18, 14, 12, 0.86);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 14px;
        text-decoration: none;
        color: #f8f3ed;
        font-size: 1.1rem;
        font-weight: 600;
        transition: all 0.15s ease;
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
      }

      .song-link:hover {
        background: rgba(246, 241, 235, 0.1);
        transform: translateY(-2px);
        border-color: rgba(255, 255, 255, 0.2);
      }

      .song-artist {
        font-size: 0.85rem;
        color: #b8ada3;
        margin-top: 4px;
        font-weight: 500;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h1>Bee Tween</h1>
      <div class="songs-list">
        {songs.map((song) => (
          <a href={`/${song.id}`} class="song-link">
            <div>{song.title}</div>
            <div class="song-artist">{song.artist}</div>
          </a>
        ))}
      </div>
    </div>
  </body>
</html>
