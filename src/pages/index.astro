---
import Seo from '../components/Seo.astro';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title="Bee Tween | Spotify & Apple Music"
      description="Bee Tween on Spotify and Apple Music. Listen to the latest tracks and follow the artist."
      url="/"
      image="/og-image.png"
      type="website"
      locale="de_DE"
    />
    <title>Bee Tween | Spotify & Apple Music</title>
    <style>
      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        background: #0c0a09;
        color: #f8f3ed;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, Helvetica, Arial, sans-serif;
      }

      body {
        position: relative;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 28px 18px;
        overflow: hidden;
      }

      body::before {
        content: '';
        position: fixed;
        inset: 0;
        background-image: url('/background.png');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        filter: blur(12px) brightness(0.48) saturate(0.85);
        transform: scale(1.08);
        z-index: 0;
      }

      body::after {
        content: '';
        position: fixed;
        inset: 0;
        background: rgba(12, 10, 9, 0.28);
        z-index: 0;
      }

      .container {
        position: relative;
        z-index: 1;
        width: min(100%, 440px);
        text-align: center;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 78px;
        height: 78px;
        margin-bottom: 18px;
        border-radius: 50%;
        overflow: hidden;
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.04));
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.22);
      }

      .brand img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      h1 {
        margin: 0;
        font-size: clamp(2.2rem, 6vw, 3.2rem);
        letter-spacing: -0.06em;
        font-weight: 800;
      }

      .subtitle {
        margin: 12px 0 28px;
        color: #c9beb5;
        font-size: 1rem;
        line-height: 1.5;
      }

      .links {
        display: flex;
        flex-direction: column;
        gap: 14px;
      }

      .platform-link {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        padding: 16px 18px;
        border-radius: 16px;
        text-decoration: none;
        color: #ffffff;
        font-size: 1.05rem;
        font-weight: 700;
        letter-spacing: 0.01em;
        transition: transform 0.15s ease, filter 0.15s ease, opacity 0.15s ease;
      }

      .platform-link:hover {
        transform: translateY(-1px);
        filter: brightness(1.04);
      }

      .platform-link:active {
        transform: translateY(0);
      }

      .spotify {
        background: #1db954;
        box-shadow: 0 16px 30px rgba(29, 185, 84, 0.28);
      }

      .apple {
        background: linear-gradient(135deg, #1a1a1a 0%, #111111 100%);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 16px 30px rgba(0, 0, 0, 0.2);
      }

      .icon {
        width: 18px;
        height: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
      }
    </style>
  </head>
  <body>
    <main class="container">
      <div class="brand">
        <img src="/avatar.png" alt="Bee Tween avatar" />
      </div>
      <h1>Bee Tween</h1>
      <p class="subtitle">Listen and follow on your favorite platform.</p>

      <div class="links">
        <a
          href="https://open.spotify.com/intl-de/artist/5xyxwTan1xzQDw3EkpVoDP?si=HPz9vv1SSdaOcMlDMHeQ-g"
          class="platform-link spotify"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="icon">♪</span>
          Spotify
        </a>

        <a
          href="https://music.apple.com/de/artist/bee-tween/6806633812"
          class="platform-link apple"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="icon">◉</span>
          Apple Music
        </a>
      </div>
    </main>
  </body>
</html>
