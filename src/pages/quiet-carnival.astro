---
import { getSongById } from '../data/songs';
import SongCard from '../components/SongCard.astro';
import Seo from '../components/Seo.astro';

const song = getSongById('quiet-carnival');

if (!song) {
  return new Response('Song not found', { status: 404 });
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title={`${song.title} — ${song.artist}`}
      description={`Listen to ${song.title} by ${song.artist} on Spotify or Apple Music.`}
      url={`/song/${song.id}`}
      image={song.coverImage}
      type="music.song"
      locale="en_US"
    />
    <title>{song.title} — {song.artist}</title>
  </head>
  <body>
    <SongCard song={song} />
  </body>
</html>
